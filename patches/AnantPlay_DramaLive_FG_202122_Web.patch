diff --git a/src/me/champdev/weblock/FgWebActivity.java b/src/me/champdev/weblock/FgWebActivity.java
new file mode 100644
--- /dev/null
+++ b/src/me/champdev/weblock/FgWebActivity.java
@@ -0,0 +1,136 @@
+package me.champdev.weblock;
+
+import android.app.Activity;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.graphics.Color;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.View;
+import android.webkit.CookieManager;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+/** The official Drama Live web player displayed in-app, with FG Code ready. */
+public final class FgWebActivity extends Activity {
+    private static final String START = "https://web.dramalive.app/";
+    private static final String FG = "fgcode.org/202122";
+    private static final String AUTO_FILL = "(function(){\n if(window.__mrxAutoCode)return;window.__mrxAutoCode=true;\n var code='fgcode.org/202122', filled=false;\n function tryFill(){\n  if(filled)return;\n  var a=Array.prototype.slice.call(document.querySelectorAll('input,textarea'));\n  var el=a.find(function(x){\n   if(x.value||x.disabled||x.readOnly)return false;\n   var t=(x.type||'text').toLowerCase();\n   if(!/^(text|url|search)$/.test(t))return false;\n   return /fg|code|source|playlist|url|link/i.test([x.name,x.id,x.placeholder,x.getAttribute('aria-label')].join(' '));\n  });\n  if(!el)return;\n  var proto=el.tagName.toLowerCase()==='textarea'?HTMLTextAreaElement.prototype:HTMLInputElement.prototype;\n  var prop=Object.getOwnPropertyDescriptor(proto,'value');\n  if(prop&&prop.set)prop.set.call(el,code);else el.value=code;\n  el.dispatchEvent(new Event('input',{bubbles:true}));\n  el.dispatchEvent(new Event('change',{bubbles:true}));filled=true;\n }\n document.addEventListener('focusin',tryFill,true);\n new MutationObserver(tryFill).observe(document.documentElement,{subtree:true,childList:true});\n setInterval(tryFill,1000);tryFill();\n})();";
+    private FrameLayout root;
+    private LinearLayout content;
+    private WebView web;
+    private View fullscreen;
+    private WebChromeClient.CustomViewCallback fullscreenCallback;
+
+    private int dp(int n) {
+        return (int)(getResources().getDisplayMetrics().density * n + .5f);
+    }
+
+    private TextView button(String text, Runnable action) {
+        TextView v = new TextView(this);
+        v.setText(text);
+        v.setGravity(Gravity.CENTER);
+        v.setTextColor(Color.WHITE);
+        v.setTextSize(14);
+        v.setPadding(dp(12), 0, dp(12), 0);
+        v.setOnClickListener(w -> action.run());
+        return v;
+    }
+
+    private boolean approved(String host) {
+        if (host == null) return false;
+        String h = host.toLowerCase(java.util.Locale.ROOT);
+        return h.equals("web.dramalive.app") || h.equals("web.dramalive.cc")
+            || h.equals("dramalive.website") || h.equals("www.dramalive.website");
+    }
+
+    private void copyCode() {
+        ClipboardManager cb = (ClipboardManager)getSystemService(CLIPBOARD_SERVICE);
+        if (cb != null) cb.setPrimaryClip(ClipData.newPlainText("FG Code", FG));
+        Toast.makeText(this, "FG Code copied: " + FG, Toast.LENGTH_SHORT).show();
+    }
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        root = new FrameLayout(this);
+        root.setBackgroundColor(0xff110d18);
+        content = new LinearLayout(this);
+        content.setOrientation(LinearLayout.VERTICAL);
+        root.addView(content, new FrameLayout.LayoutParams(-1, -1));
+
+        LinearLayout top = new LinearLayout(this);
+        top.setBackgroundColor(0xff211b2c);
+        top.setGravity(Gravity.CENTER_VERTICAL);
+        top.addView(button("‹ Back", this::finish), new LinearLayout.LayoutParams(-2, dp(52)));
+        top.addView(button("Drama Live · FG 202122", this::copyCode),
+            new LinearLayout.LayoutParams(0, dp(52), 1));
+        top.addView(button("⟳", () -> web.reload()),
+            new LinearLayout.LayoutParams(-2, dp(52)));
+        content.addView(top, new LinearLayout.LayoutParams(-1, dp(52)));
+
+        web = new WebView(this);
+        WebSettings settings = web.getSettings();
+        settings.setJavaScriptEnabled(true);
+        settings.setDomStorageEnabled(true);
+        settings.setMediaPlaybackRequiresUserGesture(false);
+        settings.setUseWideViewPort(true);
+        settings.setLoadWithOverviewMode(true);
+        CookieManager.getInstance().setAcceptCookie(true);
+        CookieManager.getInstance().setAcceptThirdPartyCookies(web, true);
+        content.addView(web, new LinearLayout.LayoutParams(-1, 0, 1));
+
+        web.setWebViewClient(new WebViewClient() {
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                if (!request.isForMainFrame()) return false;
+                return !"https".equalsIgnoreCase(request.getUrl().getScheme())
+                    || !approved(request.getUrl().getHost());
+            }
+            @Override public void onPageFinished(WebView view, String url) {
+                if (approved(android.net.Uri.parse(url).getHost()))
+                    view.evaluateJavascript(AUTO_FILL, null);
+            }
+        });
+        web.setWebChromeClient(new WebChromeClient() {
+            @Override public void onShowCustomView(View view, CustomViewCallback cb) {
+                if (fullscreen != null) { cb.onCustomViewHidden(); return; }
+                fullscreen = view;
+                fullscreenCallback = cb;
+                content.setVisibility(View.GONE);
+                root.addView(view, new FrameLayout.LayoutParams(-1, -1));
+            }
+            @Override public void onHideCustomView() {
+                if (fullscreen == null) return;
+                root.removeView(fullscreen);
+                fullscreen = null;
+                content.setVisibility(View.VISIBLE);
+                if (fullscreenCallback != null) fullscreenCallback.onCustomViewHidden();
+                fullscreenCallback = null;
+            }
+        });
+
+        setContentView(root);
+        web.loadUrl(START);
+    }
+
+    @Override public void onBackPressed() {
+        if (fullscreen != null) web.getWebChromeClient().onHideCustomView();
+        else if (web != null && web.canGoBack()) web.goBack();
+        else super.onBackPressed();
+    }
+
+    @Override protected void onDestroy() {
+        if (web != null) {
+            content.removeView(web);
+            web.destroy();
+            web = null;
+        }
+        super.onDestroy();
+    }
+}

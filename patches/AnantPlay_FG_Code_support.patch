diff --git a/src/me/champdev/weblock/FgCode.java b/src/me/champdev/weblock/FgCode.java
new file mode 100644
--- /dev/null
+++ b/src/me/champdev/weblock/FgCode.java
@@ -0,0 +1,32 @@
+package me.champdev.weblock;
+
+import java.net.URI;
+import java.net.URISyntaxException;
+
+/**
+ * Normalizes a user-supplied FG Code into its standard M3U link.
+ * This does not access any private Drama Live APIs or turn an empty FG playlist
+ * into channels. The existing Iptv.addPlaylist() validates actual M3U data.
+ */
+final class FgCode {
+    private FgCode() { }
+
+    static String playlistUrl(String input) {
+        if (input == null) return null;
+        String s = input.trim();
+        if (s.matches("[A-Za-z0-9_-]{3,64}")) return "https://fgcode.org/" + s;
+        if (!s.matches("(?i)^https?://.*")) s = "https://" + s;
+        try {
+            URI uri = new URI(s);
+            String host = uri.getHost(), path = uri.getRawPath();
+            if (host == null || !(host.equalsIgnoreCase("fgcode.org") || host.equalsIgnoreCase("www.fgcode.org"))) return null;
+            if (!uri.getScheme().equalsIgnoreCase("http") && !uri.getScheme().equalsIgnoreCase("https")) return null;
+            if (uri.getUserInfo() != null || uri.getPort() >= 0 || uri.getRawQuery() != null || uri.getRawFragment() != null) return null;
+            if (path == null || !path.matches("/[A-Za-z0-9_-]{3,64}/?")) return null;
+            String code = path.substring(1).replaceFirst("/$", "");
+            return "https://fgcode.org/" + code;
+        } catch (URISyntaxException e) {
+            return null;
+        }
+    }
+}
diff --git a/test/FgCodeTest.java b/test/FgCodeTest.java
new file mode 100644
--- /dev/null
+++ b/test/FgCodeTest.java
@@ -0,0 +1,28 @@
+package me.champdev.weblock;
+
+public final class FgCodeTest {
+    static void eq(String expected, String actual) {
+        if (expected == null ? actual != null : !expected.equals(actual))
+            throw new AssertionError("Expected " + expected + ", got " + actual);
+    }
+    public static void main(String[] args) {
+        String expect = "https://fgcode.org/202122";
+        eq(expect, FgCode.playlistUrl("202122"));
+        eq(expect, FgCode.playlistUrl("fgcode.org/202122"));
+        eq(expect, FgCode.playlistUrl("http://fgcode.org/202122"));
+        eq(expect, FgCode.playlistUrl("https://www.fgcode.org/202122/"));
+        eq(expect, FgCode.playlistUrl(" https://fgcode.org/202122 "));
+        eq("https://fgcode.org/abc_123", FgCode.playlistUrl("abc_123"));
+        eq(null, FgCode.playlistUrl(null));
+        eq(null, FgCode.playlistUrl(""));
+        eq(null, FgCode.playlistUrl("fgcode.org"));
+        eq(null, FgCode.playlistUrl("fgcode.org/202122?q=1"));
+        eq(null, FgCode.playlistUrl("fgcode.org/202122#fragment"));
+        eq(null, FgCode.playlistUrl("https://attacker.example/202122"));
+        eq(null, FgCode.playlistUrl("https://fgcode.org.evil.example/202122"));
+        eq(null, FgCode.playlistUrl("https://user:pw@fgcode.org/202122"));
+        eq(null, FgCode.playlistUrl("https://fgcode.org:443/202122"));
+        eq(null, FgCode.playlistUrl("https://fgcode.org/202122/other"));
+        System.out.println("FG Code URL parser: 16 tests passed");
+    }
+}
